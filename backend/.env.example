# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI).
# Use the "Session pooler" (port 6543) connection for serverless-friendly pooling, or the
# direct connection (port 5432) for local dev / migrations.
DATABASE_URL="postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# Supabase project settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
# Settings -> API -> JWT Settings -> JWT Secret (used to verify access tokens issued to the frontend)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@zestchocolates.example"

# CORS: comma-separated list of frontend origins allowed to call this API
FRONTEND_URL="http://localhost:3000,https://your-app.vercel.app"
